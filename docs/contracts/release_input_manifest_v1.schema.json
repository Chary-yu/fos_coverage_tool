{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fos.local/contracts/release_input_manifest_v1.schema.json",
  "title": "FOS offline release input manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "repository",
    "source_commit_sha",
    "source_tree_sha",
    "source_bundle_sha256",
    "tooling_commit_sha",
    "tooling_tree_sha",
    "tooling_bundle_sha256",
    "production_host",
    "baseline_commit_sha",
    "baseline_attempt_id",
    "baseline_tree_sha256",
    "baseline_manifest_sha256",
    "baseline_adoption_identity_sha256",
    "project_name",
    "candidate_parent",
    "release_trust_mode"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "source_commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "source_tree_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "source_bundle_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "tooling_commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "tooling_tree_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "tooling_bundle_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "production_host": {"type": "string", "minLength": 1},
    "baseline_commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "baseline_attempt_id": {"type": "string", "minLength": 1},
    "baseline_tree_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "baseline_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "baseline_adoption_identity_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "project_name": {"type": "string", "minLength": 1},
    "candidate_parent": {"type": "string", "pattern": "^/.*"},
    "release_trust_mode": {"const": "offline_operator"},
    "candidate_build_mode": {"enum": ["production", "flat_production", "validation_fixture"]},
    "production_publishable": {"const": false},
    "baseline_root": {"type": "string", "pattern": "^/.*"},
    "baseline_manifest_path": {"type": "string", "pattern": "^/.*"},
    "baseline_adoption_identity_path": {"type": "string", "pattern": "^/.*"},
    "flat_served_root": {"type": "string", "pattern": "^/.*"},
    "flat_release_identity_path": {"type": "string", "pattern": "^/.*"},
    "production_publish_root": {"type": "string", "pattern": "^/.*"},
    "application_root": {"type": "string", "pattern": "^/.*"},
    "validation_session_id": {"type": "string", "minLength": 1},
    "operator_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  }
}
