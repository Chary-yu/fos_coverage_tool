{
  "schema_version": 1,
  "contract_version": "vnext-api-20260831.1",
  "contract_id": "vnext-inheritance-api-v1",
  "runtime": "vnext",
  "routes": {
    "scan_create": "POST /api/coverage/scans",
    "job_detail": "GET /api/coverage/jobs/{job_id}",
    "inheritance_pending": "GET /api/coverage/scans/{scan_id}/inheritance/pending",
    "inheritance_relation": "GET /api/coverage/scans/{scan_id}/inheritance/relation",
    "inheritance_decisions": "GET /api/coverage/scans/{scan_id}/inheritance/decisions",
    "inheritance_confirm": "POST /api/coverage/scans/{scan_id}/inheritance/confirm",
    "inheritance_edit_confirm": "POST /api/coverage/scans/{scan_id}/inheritance/edit-confirm",
    "inheritance_reject": "POST /api/coverage/scans/{scan_id}/inheritance/reject",
    "inheritance_undo": "POST /api/coverage/scans/{scan_id}/inheritance/rejections/{rejection_id}/undo",
    "progress": "GET /api/coverage/progress",
    "progress_details": "GET /api/coverage/progress/details",
    "progress_files": "GET /api/coverage/progress/files",
    "progress_pending": "GET /api/coverage/progress/pending",
    "pending_files": "GET /api/coverage/incremental/unanalyzed",
    "pending_file_lines": "GET /api/coverage/scans/{scan_id}/files/{file_id}/pending-lines"
  },
  "pagination": {
    "default_limit": 100,
    "maximum_limit": 500,
    "cursor_binding": ["scan_id", "data_version", "filter"],
    "progress_details_envelope": ["scan_id", "file_id", "page_size", "has_more", "rows", "next_cursor"],
    "progress_files_envelope": ["project_name", "scan_id", "data_version", "repository_name", "files", "page_size", "has_more", "next_cursor"],
    "progress_pending_envelope": ["scan_id", "page_size", "total", "rows", "has_more", "next_cursor"],
    "pending_files_envelope": ["project_name", "scan_id", "data_version", "repository_name", "files", "page_size", "has_more", "next_cursor"],
    "pending_file_lines_envelope": ["project_name", "scan_id", "file_id", "data_version", "repository_name", "file_path", "page_size", "total", "pending_line_numbers", "has_more", "next_cursor"],
    "progress_files_identity": {
      "scan_id": "integer or null only when the project has no current Scan",
      "data_version": "non-negative integer",
      "request_scan_id_echo": true
    },
    "pending_files_identity": {
      "scan_id": "integer or null only when the project has no current Scan",
      "data_version": "non-negative integer",
      "request_scan_id_echo": true
    },
    "pending_file_lines_identity": {
      "scan_id": "integer",
      "file_id": "integer bound to scan_id",
      "data_version": "non-negative integer",
      "cursor_binding": ["scan_id", "data_version", "file_id"],
      "request_scan_id_echo": true,
      "request_file_id_echo": true
    },
    "pending_file_fields": {
      "pending_line_numbers_complete": "boolean; true means pending_line_numbers is complete, false means the list is intentionally omitted and must be loaded from pending_file_lines",
      "pending_line_numbers": "complete list only when pending_line_numbers_complete is true; otherwise an empty list has no zero-pending meaning"
    }
  },
  "progress_summary": {
    "required_fields": [
      "total_uncovered",
      "filled_total",
      "draft_total",
      "confirmed_total",
      "pending_total",
      "ordinary_pending_total",
      "inherited_pending_total",
      "manual_draft_pending_total",
      "pending_conservation",
      "data_version",
      "file_state_version",
      "source",
      "derived_state_status"
    ],
    "display_rates": {
      "fill_rate": "filled_total * 100 / total_uncovered when total_uncovered > 0, otherwise 0",
      "confirmed_rate": "confirmed_total * 100 / total_uncovered when total_uncovered > 0, otherwise 0"
    },
    "deprecated_fields": [
      "unfilled_total",
      "coverable_total",
      "uncoverable_total",
      "redundant_total",
      "fill_rate",
      "confirmed_rate"
    ],
    "optional_dimensions": {
      "ownership": "not included in the canonical VNext summary unless explicitly supplied by a future ownership DTO",
      "teams": "not included in the canonical VNext summary unless explicitly supplied by a future team DTO",
      "dirs": "not included in the canonical VNext summary unless explicitly supplied by a future directory DTO",
      "client_rendering": "clients must hide unsupported optional dimensions; missing fields must not be rendered as zero or an empty-data result"
    }
  },
  "mutation_identity": [
    "project",
    "scan_id",
    "repository_name",
    "file_path",
    "line_id_or_line_number",
    "expected_relation_revision"
  ],
  "inheritance_relation_query": {
    "required": ["scan_id", "repository_name", "file_path"],
    "one_of": ["line_id", "relation_id", "line_number"],
    "response": ["scan_id", "data_version", "item"],
    "global_pending_list_fallback": false
  },
  "mutation_rules": {
    "current_scan_only": true,
    "authenticated_operator_is_reviewer": true,
    "client_suggested_reviewer_is_not_credential": true,
    "edit_requires_expected_record_revision": true,
    "undo_requires_expected_rejection_revision": true
  },
  "roles": {
    "viewer": ["read"],
    "reviewer": ["read", "confirm", "edit_confirm", "reject", "undo"],
    "importer": ["read", "create_scan"],
    "admin": ["read", "confirm", "edit_confirm", "reject", "undo", "create_scan"]
  },
  "error_codes": [
    "REPOSITORY_BUSY",
    "SCAN_NOT_CURRENT_FOR_MUTATION",
    "STALE_RELATION_REVISION",
    "STALE_RECORD_REVISION",
    "STALE_REJECTION_REVISION",
    "UNDO_NOT_ALLOWED",
    "INVALID_SCAN_IDENTITY",
    "PAGINATION_CURSOR_STALE",
    "PAGINATION_CURSOR_REQUIRED",
    "PENDING_SNAPSHOT_STALE"
  ],
  "progress_conservation": [
    "ordinary_pending_total",
    "inherited_pending_total",
    "manual_draft_pending_total",
    "confirmed_total",
    "pending_total"
  ]
}
