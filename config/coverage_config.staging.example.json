{
  "mysql": {
    "host": "127.0.0.1",
    "port": 13306,
    "user": "coverage_user",
    "password": "CHANGE_ME",
    "database": "coverage_candidate",
    "connect_timeout": 5,
    "backup_restore_database": "coverage_restore_smoke",
    "backup_restore_user": "root",
    "backup_restore_password": ""
  },
  "server": {
    "host": "127.0.0.1",
    "port": 19528
  },
  "auth": {
    "mode": "reverse_proxy",
    "user_header": "X-Remote-User",
    "trusted_proxy_addresses": ["127.0.0.1", "::1"],
    "allowed_origins": ["http://127.0.0.1:19528", "http://localhost:19528"]
  },
  "runtime_state": {
    "root": ".runtime-state-staging",
    "jobs_dir": "jobs",
    "registry_dir": "report-registry",
    "exports_dir": "exports"
  },
  "input_roots": [".runtime-state-staging/inputs"],
  "report_roots": [".runtime-state-staging/reports"],
  "runtime_mode": "vnext",
  "schema_version": 1,
  "environment": "candidate",
  "upgrade": {
    "drain_timeout_sec": 30,
    "validation_candidate_root": "../coverage-validation-candidate",
    "validation_candidate_artifact_manifest": "../coverage-validation-candidate/candidate_artifact_manifest.json",
    "production_candidate_root": "../coverage-production-release-candidate",
    "production_candidate_artifact_manifest": "../coverage-production-release-candidate/candidate_artifact_manifest.json",
    "production_candidate_build_receipt": "../coverage-production-release-candidate/candidate_build_receipt.json",
    "production_candidate_attestation_bundle": "../coverage-production-release-candidate-attestation/candidate_build_attestation.bundle.json",
    "production_candidate_attestation_repository": "Chary-yu/fos_coverage_tool",
    "production_candidate_attestation_workflow": "Chary-yu/fos_coverage_tool/.github/workflows/trusted-production-candidate-builder.yml",
    "publish_root": "../coverage-published-releases",
    "served_root_path": "../coverage-published-releases/CURRENT/reports",
    "validation_candidate_builder_workflow_identity": "github-actions/trusted-candidate-builder",
    "validation_candidate_builder_workflow_sha": "ec7df3820b07b38b56c1df9d01a4572ec1e9e087",
    "production_candidate_builder_workflow_identity": "github-actions/trusted-production-candidate-builder",
    "production_candidate_builder_workflow_sha": "ec7df3820b07b38b56c1df9d01a4572ec1e9e087",
    "validation_session_manifest": ".runtime-state-staging/validation-session-{attempt_id}.json",
    "validation_teardown_evidence_path": ".artifacts/staging/validation-teardown-{attempt_id}.json",
    "serving_session_id": "current-serving",
    "serving_session_manifest": ".runtime-state-staging/serving-session.json",
    "serving_teardown_evidence_path": ".artifacts/staging/serving-teardown.json",
    "current_serving_state_path": ".runtime-state-staging/current-serving.json",
    "validation_ports": [19528],
    "validation_teardown_timeout_sec": 10,
    "release_endpoint": "http://127.0.0.1:19528/api/coverage/release",
    "health_endpoint": "http://127.0.0.1:19528/api/coverage/health",
    "served_root_probe_url": "http://127.0.0.1:19528/coverage/",
    "served_root_url_prefix": "/coverage/",
    "served_root_probe_relative_path": "index.html",
    "candidate_browser_url": "https://candidate.example.invalid/",
    "candidate_browser_evidence_path": ".artifacts/staging/candidate-browser-{attempt_id}.json",
    "previous_release_endpoint": "http://127.0.0.1:9528/api/coverage/release",
    "rollback_evidence_path": ".artifacts/staging/rollback-{attempt_id}.json",
    "performance_evidence_path": ".artifacts/staging/release-performance-ab-{attempt_id}.json",
    "path_mapping_source_paths": ["tests/fixtures/path_mapping"],
    "path_mapping_lcov_paths": ["tests/fixtures/path_mapping/coverage.info"],
    "commands": {
      "freeze_traffic": ["python3", "scripts/upgrade/local_staging_control.py", "freeze", "--config", "config/coverage_config.staging.example.json", "--pid-file", ".runtime-state-staging/api.pid"],
      "drain_jobs": ["python3", "scripts/upgrade/local_staging_control.py", "drain", "--config", "config/coverage_config.staging.example.json", "--pid-file", ".runtime-state-staging/api.pid"],
      "stop_current_api": ["python3", "scripts/upgrade/local_staging_control.py", "stop-current", "--config", "coverage_config.json", "--pid-file", ".runtime-state/api.pid", "--session-manifest", ".runtime-state/api.pid.session.json", "--state-file", ".runtime-state-staging/current-serving.json"],
      "stop_validation_api": ["python3", "scripts/upgrade/local_staging_control.py", "stop", "--config", "config/coverage_config.staging.example.json", "--pid-file", ".runtime-state-staging/api.pid"],
      "start_validation_api": ["python3", "scripts/upgrade/local_staging_control.py", "start", "--config", "config/coverage_config.staging.example.json", "--pid-file", ".runtime-state-staging/api.pid", "--endpoint", "http://127.0.0.1:19528/api/coverage/release"],
      "start_serving_api": ["python3", "scripts/upgrade/local_staging_control.py", "start", "--serving", "--config", "config/coverage_config.staging.example.json", "--pid-file", ".runtime-state-staging/serving-api.pid", "--session-manifest", ".runtime-state-staging/serving-session.json", "--session-id", "current-serving", "--state-file", ".runtime-state-staging/current-serving.json", "--endpoint", "http://127.0.0.1:19528/api/coverage/release"],
      "stop_serving_api": ["python3", "scripts/upgrade/local_staging_control.py", "stop", "--serving", "--config", "config/coverage_config.staging.example.json", "--pid-file", ".runtime-state-staging/serving-api.pid", "--session-manifest", ".runtime-state-staging/serving-session.json", "--state-file", ".runtime-state-staging/current-serving.json"],
      "start_previous_api": ["python3", "scripts/upgrade/local_staging_control.py", "start", "--config", "coverage_config.json", "--pid-file", ".runtime-state/api.pid", "--endpoint", "http://127.0.0.1:9528/api/coverage/release"],
      "open_traffic": ["python3", "scripts/upgrade/local_staging_control.py", "open", "--config", "config/coverage_config.staging.example.json", "--pid-file", ".runtime-state-staging/api.pid"]
    }
  }
}
